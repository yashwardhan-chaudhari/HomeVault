# APP_URL: The public or local URL where this application is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens (REQUIRED - no hardcoded fallback).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_strong_random_secret_in_production"

# PORT: Server port (defaults to 3000)
PORT=3000
